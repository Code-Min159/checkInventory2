<mapper namespace="com.workExample.checkInventory.dao.ProductMapper">
<!--//Namespace對應到Java接口>ProductMapper.java -->
    <resultMap id="ProductWithMaterialsResult" type="com.workExample.checkInventory.dataObject.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
       <collection property="materials" javaType="java.util.List" ofType="com.workExample.checkInventory.dataObject.Material">
       <!--//collection property=Product.java中的materials屬性: javaType=List集合 -->
            <id property="id" column="m_id"/>
            <result property="name" column="m_name"/>
        </collection>
    </resultMap>

    <select id="getProducWithMaterials" resultMap="ProductWithMaterialsResult">
    <!--//select id= ProductMapper.java中getProducWithMaterials的方法名稱: resultMap=要回應到哪個物件的結構(也就是上面resultMap的物件)-->
        SELECT pm.id as p_id, pm.name as p_name, material.id as m_id, material.name as m_name
        FROM
        (SELECT p.id, p.name, m.material_id
            FROM product AS p
            LEFT JOIN
            product_material_mapping AS pm
            ON p.id = m.product_id) as pm
        LEFT JOIN
        material
        ON pm.material_id = material.id
        WHERE
        pm.id = #{id}
    </select>

    <insert id="addMaterial">
        INSERT INTO product_material_mapping (product_id, material_id)
        VALUES (#{productId}, #{materialId})
    </insert>


