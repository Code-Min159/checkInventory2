        <resultMap id="updateProductResult" type="com.workExample.checkInventory.dataObject.Product">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
            <result property="unit" column="unit"/>
            <result property="description" column="description"/>
            <result property="category" column="category"/>
            <result property="supplier" column="supplier"/>
            <result property="location" column="location"/>
            <result property="safeStock" column="safe_stock"/>
            <result property="isFoodAddtives" column="is_foodAddtives"/>
            <result property="isFoodAllergen" column="is_foodAllergen"/>
            <result property="isOutOfDate" column="is_out_of_date"/>
            <result property="effectiveDate" column="effective_date"/>
            <collection property="materials" javaType="java.util.List" ofType="com.workExample.checkInventory.dataObject.Material">
                <!--//collection property=Product.java中的materials屬性: javaType=List集合 -->
                <id property="id" column="m_id"/>
                <result property="name" column="m_name"/>
            </collection>
        </resultMap>
    <update id="updateProduct" parameterType="com.workExample.checkInventory.dataObject.Product">
        UPDATE product
        SET name = #{name},
            unit = #{unit},
            description = #{description},
            category = #{category},
            supplier = #{supplier},
            location = #{location},
            safeStock = #{safeStock},
            isFoodAddtives = #{isFoodAddtives},
            isFoodAllergen = #{isFoodAllergen},
            isOutOfDate = #{isOutOfDate},
            effectiveDate = #{effectiveDate}
        WHERE id = #{id}
    </update>

